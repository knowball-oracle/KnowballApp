{
  "name": "knowballapp",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "prebuild:version": "node scripts/write-version.js",
    "start": "node scripts/write-version.js && expo start",
    "android": "node scripts/write-version.js && expo start --android",
    "ios": "node scripts/write-version.js && expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build:android": "node scripts/write-version.js && npx eas-cli build --platform android --profile preview"
  },
  "dependencies": {
    "@expo-google-fonts/sora": "^0.4.2",
